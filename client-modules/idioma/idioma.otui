// Nó de raiz SEM "<": um "Nome < Base" so declara estilo e nao instancia nada,
// o que fazia o g_ui.displayUI("idioma") devolver nil.
MainWindow
  id: janelaIdioma
  !text: tr('Idioma dos NPCs')
  size: 250 130
  @onEscape: modules.idioma.alternar()

  Label
    id: aviso
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    text-auto-resize: true
    !text: tr('Escolha em que idioma os NPCs falam com voce. Voce pode digitar nos dois de qualquer jeito.')
    text-wrap: true

  Button
    id: btPt
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 12
    width: 180
    text: Portugues (BR)

  Button
    id: btEn
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    width: 180
    text: English (US)
