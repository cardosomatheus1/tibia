// ================= janela =================
MainWindow
  id: autocasterWindow
  !text: tr('AutoCaster')
  size: 400 580
  @onEscape: modules.autocaster.toggle()

  // ---- barra de presets ----
  ACSecao
    id: barraPreset
    anchors.top: parent.top
    height: 30

    Label
      id: lblPreset
      !text: tr('Preset:')
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      width: 42
      height: 16

    ComboBox
      id: comboPreset
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      width: 120
      height: 20

    Button
      id: btNovo
      !text: tr('Novo')
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      width: 56
      height: 20

    Button
      id: btRemover
      !text: tr('Remover')
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      width: 68
      height: 20

  // TabBar (UITabBar), nao MoveableTabBar: o MoveableTabBar esconde as abas que
  // nao cabem e as move para um postTabs alcancavel so por setas de navegacao,
  // que esta janela nao tem -- com 4 abas, tres desapareciam.
  //
  // O UITabBar dimensiona a aba pela largura do TEXTO. Por isso o addTab aqui
  // NAO passa icone: o icone entrava por mergeStyle depois, sem entrar na
  // conta da largura, e estourava o conteudo da aba.
  TabBar
    id: abas
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 22

  Panel
    id: conteudoAbas
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: rodape.top
    margin-top: 6
    margin-bottom: 6

  // ---- rodapé ----
  ACSecao
    id: rodape
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 48

    CheckBox
      id: ligado
      !text: tr('Helper Status:')
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 4
      margin-top: 2
      height: 18
      width: 110

    Label
      id: statusTexto
      !text: tr('Disabled')
      anchors.left: prev.right
      anchors.verticalCenter: prev.verticalCenter
      margin-left: 4
      height: 16
      width: 70
      color: #ff6666

    Button
      id: btFechar
      !text: tr('Fechar')
      anchors.right: parent.right
      anchors.top: parent.top
      margin-right: 4
      margin-top: 2
      width: 64
      height: 20

    Label
      id: status
      !text: tr('')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 4
      margin-bottom: 2
      height: 14
      color: #b0d8b0
