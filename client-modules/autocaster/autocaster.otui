// ================= peças reutilizáveis =================

ACSecao < FlatPanel
  anchors.left: parent.left
  anchors.right: parent.right
  padding: 4

ACTitulo < Label
  height: 14
  color: #7fb3ff
  text-align: center
  anchors.left: parent.left
  anchors.right: parent.right

ACCabecalho < Label
  height: 12
  color: #9a9a9a
  font: verdana-11px-rounded

ACSlot < Item
  virtual: true
  &selectable: true
  &editable: true
  size: 32 32

// ---- linha de cura: [on] [slot] [magia/item] [%] ----
LinhaCura < Panel
  height: 36
  anchors.left: parent.left
  anchors.right: parent.right

  CheckBox
    id: on
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    size: 16 16

  ACSlot
    id: slot
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 24

  UIWidget
    id: magia
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 24
    size: 32 32
    image-source: /images/ui/panel_flat
    image-border: 1
    focusable: false
    phantom: false

  TextEdit
    id: texto
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 60
    width: 96
    height: 20

  SpinBox
    id: pct
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 162
    width: 52
    height: 20
    minimum: 1
    maximum: 100

// ---- linha do shooter: [on] [slot] [spell] [mana] [mobs] [prio] ----
LinhaShooter < Panel
  height: 36
  anchors.left: parent.left
  anchors.right: parent.right

  CheckBox
    id: on
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    size: 16 16

  ACSlot
    id: slot
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 24

  UIWidget
    id: magia
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 24
    size: 32 32
    image-source: /images/ui/panel_flat
    image-border: 1
    focusable: false
    phantom: false

  TextEdit
    id: texto
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 60
    width: 92
    height: 20

  SpinBox
    id: mana
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 158
    width: 48
    height: 20
    minimum: 0
    maximum: 100

  SpinBox
    id: mobs
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 212
    width: 42
    height: 20
    minimum: 1
    maximum: 10

  ComboBox
    id: prio
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 260
    width: 56
    height: 20


// ---- seletor de magias (abre ao clicar no icone) ----
LinhaMagia < UIWidget
  // Sem ancoras: o pai (ScrollablePanel "lista") usa layout verticalBox, que
  // proibe ancoras e ja estica a largura de quem nao tem tamanho fixo.
  height: 36
  focusable: true
  phantom: false
  text-align: left
  text-offset: 42 10
  color: #dddddd
  font: verdana-11px-rounded

  $focus:
    background-color: #3a5a8a

SeletorMagia < MainWindow
  id: seletorMagia
  !text: tr('Escolher magia')
  size: 320 400

  TextEdit
    id: filtro
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 20

  ScrollablePanel
    id: lista
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: btCancelar.top
    margin-top: 4
    margin-bottom: 6
    vertical-scrollbar: barra
    layout:
      type: verticalBox

  VerticalScrollBar
    id: barra
    anchors.top: lista.top
    anchors.bottom: lista.bottom
    anchors.right: parent.right
    step: 36
    pixels-scroll: true

  Button
    id: btCancelar
    !text: tr('Cancelar')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 80
    height: 22


// ---- seletor de item: lista fechada, so potions ou so runas ----
// Substitui o seletor genérico do client, que pedia o id numérico e aceitava
// qualquer coisa — dava para pôr uma espada no slot de potion.
LinhaItem < UIWidget
  // Sem ancoras: o pai (ScrollablePanel "lista") usa layout verticalBox, que
  // proibe ancoras e ja estica a largura de quem nao tem tamanho fixo.
  //
  // O texto vai na PROPRIA linha, com text-offset, e nao num Label filho: um
  // Label ancorado sem altura nem auto-resize corta a segunda linha. E' o mesmo
  // arranjo do LinhaMagia, que ja funciona.
  height: 36
  focusable: true
  phantom: false
  text-align: left
  text-offset: 42 4
  text-wrap: true
  color: #dddddd
  font: verdana-11px-rounded

  $focus:
    background-color: #3a5a8a

  Item
    id: sprite
    virtual: true
    phantom: true
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    size: 32 32

SeletorItem < MainWindow
  id: seletorItem
  !text: tr('Escolher item')
  size: 340 400

  TextEdit
    id: filtro
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 20

  ScrollablePanel
    id: lista
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: btCancelar.top
    margin-top: 4
    margin-bottom: 6
    vertical-scrollbar: barra
    layout:
      type: verticalBox

  VerticalScrollBar
    id: barra
    anchors.top: lista.top
    anchors.bottom: lista.bottom
    anchors.right: parent.right
    step: 36
    pixels-scroll: true

  Button
    id: btCancelar
    !text: tr('Cancelar')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 80
    height: 22


// ---- linha do alvo: [on] [nome do monstro] [prioridade] [dist] ----
LinhaAlvo < Panel
  height: 26
  anchors.left: parent.left
  anchors.right: parent.right

  CheckBox
    id: on
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    size: 16 16

  TextEdit
    id: nome
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 26
    width: 150
    height: 20

  ComboBox
    id: prio
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 182
    width: 56
    height: 20

  SpinBox
    id: dist
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 244
    width: 44
    height: 20
    minimum: 1
    maximum: 10

// ================= aba: HEALING =================
